<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Csls.Benchmarks</AssemblyName>
    <RootNamespace>Csls.Benchmarks</RootNamespace>
    <Description>BenchmarkDotNet coverage for performance-sensitive csls components.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.NET.StringTools"
                      ExcludeAssets="runtime"
                      PrivateAssets="all" />
    <PackageReference Include="StreamJsonRpc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Csls.App/Csls.App.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Csls.Cli.Worker/Csls.Cli.Worker.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Csls.Core/Csls.Core.csproj" />
    <ProjectReference Include="../../src/Csls.Protocol/Csls.Protocol.csproj" />
    <ProjectReference Include="../../src/Csls.Rpc/Csls.Rpc.csproj" />
    <ProjectReference Include="../../src/Csls.Workspaces/Csls.Workspaces.csproj" />
    <ProjectReference Include="../../src/Csls.Worker/Csls.Worker.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
