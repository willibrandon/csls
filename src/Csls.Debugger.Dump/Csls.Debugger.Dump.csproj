    <RootNamespace>Csls.Debugger.Dump</RootNamespace>
    <Description>Read-only managed process-dump inspection for the csls debugger.</Description>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Csls.Debugger.Tests" />
