<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Csls.DebugAdapter</AssemblyName>
    <RootNamespace>Csls.DebugAdapter</RootNamespace>
    <Description>The NativeAOT-compatible Debug Adapter Protocol host for csls.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Csls.Debugger.Tests" />
    <ProjectReference Include="../Csls.Debugger/Csls.Debugger.csproj" />
    <ProjectReference Include="../Csls.Debugger.Contracts/Csls.Debugger.Contracts.csproj" />
    <ProjectReference Include="../Csls.Debugger.Control/Csls.Debugger.Control.csproj" />
  </ItemGroup>
</Project>
