<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>csls-worker</AssemblyName>
    <RootNamespace>Csls.Worker</RootNamespace>
    <Description>The self-contained ReadyToRun Roslyn worker supervised by csls.</Description>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Csls.Rpc/Csls.Rpc.csproj" />
    <ProjectReference Include="../Csls.Server/Csls.Server.csproj" />
  </ItemGroup>
</Project>
