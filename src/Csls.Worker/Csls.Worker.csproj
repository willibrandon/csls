<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>csls-worker</AssemblyName>
    <RootNamespace>Csls.Worker</RootNamespace>
    <Description>The self-contained ReadyToRun Roslyn worker supervised by csls.</Description>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'any'">true</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(PublishReadyToRun)' == ''">false</PublishReadyToRun>
    <SelfContained Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'any'">true</SelfContained>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Csls.Control.Server/Csls.Control.Server.csproj" />
    <ProjectReference Include="../Csls.Rpc/Csls.Rpc.csproj" />
    <ProjectReference Include="../Csls.Server/Csls.Server.csproj" />
    <ProjectReference Include="../Csls.Workspaces.MSBuild/Csls.Workspaces.MSBuild.csproj" />
  </ItemGroup>
</Project>
