<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>csls-debugger-worker</AssemblyName>
    <RootNamespace>Csls.Debugger.Worker</RootNamespace>
    <Description>The self-contained interactive csls debugger worker.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot Condition="'$(RuntimeIdentifier)' != '' and
                           '$(RuntimeIdentifier)' != 'any' and
                           '$(RuntimeIdentifier)' != 'win-x86'">true</PublishAot>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' == 'win-x86'">true</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(PublishReadyToRun)' == ''">false</PublishReadyToRun>
    <SelfContained Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'any'">true</SelfContained>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Csls.DebugAdapter/Csls.DebugAdapter.csproj" />
    <ProjectReference Include="../Csls.Debugger.Control/Csls.Debugger.Control.csproj" />
    <ProjectReference Include="../Csls.Debugger.Terminal/Csls.Debugger.Terminal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <CslsBundledWorker Include="../Csls.Debugger.Evaluator.Worker/Csls.Debugger.Evaluator.Worker.csproj">
      <BundlePath>evaluator</BundlePath>
    </CslsBundledWorker>
  </ItemGroup>

  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <_CslsUnixWaitRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'any'">$(RuntimeIdentifier)</_CslsUnixWaitRuntimeIdentifier>
    <_CslsUnixWaitRuntimeIdentifier Condition="'$(_CslsUnixWaitRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</_CslsUnixWaitRuntimeIdentifier>
    <_CslsUnixWaitArtifactsPath>$([MSBuild]::NormalizePath('$(ArtifactsPath)', 'unix-wait', '$(_CslsUnixWaitRuntimeIdentifier)'))</_CslsUnixWaitArtifactsPath>
    <_CslsUnixWaitPublishDirectory>$([MSBuild]::NormalizePath('$(_CslsUnixWaitArtifactsPath)', 'publish', '$(Configuration)'))</_CslsUnixWaitPublishDirectory>
    <_CslsUnixWaitFileName Condition="$(_CslsUnixWaitRuntimeIdentifier.StartsWith('osx-'))">Csls.Debugger.UnixWait.dylib</_CslsUnixWaitFileName>
    <_CslsUnixWaitFileName Condition="'$(_CslsUnixWaitFileName)' == ''">Csls.Debugger.UnixWait.so</_CslsUnixWaitFileName>
    <_CslsUnixWaitSourcePath Condition="'$(CslsUnixWaitInterposerPath)' != ''">$([MSBuild]::NormalizePath('$(CslsUnixWaitInterposerPath)'))</_CslsUnixWaitSourcePath>
    <_CslsUnixWaitSourcePath Condition="'$(_CslsUnixWaitSourcePath)' == ''">$([MSBuild]::NormalizePath('$(_CslsUnixWaitPublishDirectory)', '$(_CslsUnixWaitFileName)'))</_CslsUnixWaitSourcePath>
  </PropertyGroup>

  <Target Name="_PublishCslsUnixWaitInterposer"
          BeforeTargets="CoreCompile"
          Condition="!$([MSBuild]::IsOSPlatform('Windows')) and
                     '$(DesignTimeBuild)' != 'true' and
                     '$(CslsUnixWaitInterposerPath)' == ''">
    <MSBuild Projects="../Csls.Debugger.UnixWait/Csls.Debugger.UnixWait.csproj"
             Targets="Restore"
             BuildInParallel="false"
             Properties="ArtifactsPath=$(_CslsUnixWaitArtifactsPath);Configuration=$(Configuration);RuntimeIdentifier=$(_CslsUnixWaitRuntimeIdentifier);PublishDir=$(_CslsUnixWaitPublishDirectory);NativeLib=Shared;PublishAot=true;SelfContained=true;CslsUnixWaitBuildPhase=Restore"
             RemoveProperties="CslsBundledWorkerArtifactsPath;CslsBundledWorkerPublishDir;PublishReadyToRun;PublishSingleFile" />
    <MSBuild Projects="../Csls.Debugger.UnixWait/Csls.Debugger.UnixWait.csproj"
             Targets="Publish"
             BuildInParallel="false"
             Properties="ArtifactsPath=$(_CslsUnixWaitArtifactsPath);Configuration=$(Configuration);RuntimeIdentifier=$(_CslsUnixWaitRuntimeIdentifier);PublishDir=$(_CslsUnixWaitPublishDirectory);NativeLib=Shared;PublishAot=true;SelfContained=true;CslsUnixWaitBuildPhase=Publish"
             RemoveProperties="CslsBundledWorkerArtifactsPath;CslsBundledWorkerPublishDir;PublishReadyToRun;PublishSingleFile" />
  </Target>

  <Target Name="_CopyCslsUnixWaitInterposer"
          AfterTargets="Build;Publish"
          Condition="!$([MSBuild]::IsOSPlatform('Windows')) and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(_CslsUnixWaitSourcePath)')"
           Text="The debugger Unix wait interposer is missing: $(_CslsUnixWaitSourcePath)" />
    <Copy SourceFiles="$(_CslsUnixWaitSourcePath)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_CslsUnixWaitSourcePath)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != '' and '$(PublishDir)' != '$(TargetDir)'" />
  </Target>

  <Import Project="../../build/Csls.BundledWorkers.targets" />
</Project>
