<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>csls-mcp-worker</AssemblyName>
    <RootNamespace>Csls.Mcp.Worker</RootNamespace>
    <Description>The self-contained ReadyToRun MCP bridge supervised by csls-mcp.</Description>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'any'">true</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(PublishReadyToRun)' == ''">false</PublishReadyToRun>
    <SelfContained Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'any'">true</SelfContained>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Csls.Client/Csls.Client.csproj" />
    <ProjectReference Include="../Csls.Control/Csls.Control.csproj" />
    <ProjectReference Include="../Csls.Control.Contracts/Csls.Control.Contracts.csproj" />
    <ProjectReference Include="../Csls.Debugger/Csls.Debugger.csproj" />
    <ProjectReference Include="../Csls.Debugger.Control/Csls.Debugger.Control.csproj" />
    <ProjectReference Include="../Csls.Debugger.Contracts/Csls.Debugger.Contracts.csproj" />
    <ProjectReference Include="../Csls.Rpc/Csls.Rpc.csproj" />
  </ItemGroup>
</Project>
