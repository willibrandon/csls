<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>csls-cli-worker</AssemblyName>
    <RootNamespace>Csls.Cli.Worker</RootNamespace>
    <Description>The self-contained ReadyToRun control client supervised by csls.</Description>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'any'">true</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(PublishReadyToRun)' == ''">false</PublishReadyToRun>
    <SelfContained Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'any'">true</SelfContained>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Csls.Client/Csls.Client.csproj" />
    <ProjectReference Include="../Csls.Control/Csls.Control.csproj" />
    <ProjectReference Include="../Csls.Control.Contracts/Csls.Control.Contracts.csproj" />
    <ProjectReference Include="../Csls.Dashboard/Csls.Dashboard.csproj" />
  </ItemGroup>
</Project>
