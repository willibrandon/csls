{
  "name": "csls",
  "image": "mcr.microsoft.com/devcontainers/base:noble",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0.400"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24.19.0"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "1.98.0",
      "profile": "minimal",
      "targets": "wasm32-wasip2",
      "components": "rust-analyzer,rust-src,rustfmt,clippy"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "2.97.0"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "dockerDashComposeVersion": "none"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "64gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "github.vscode-github-actions",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "dotnet.defaultSolution": "Csls.slnx",
        "dotnet.preferVisualStudioCodeFileSystemWatcher": true
      }
    }
  },
  "forwardPorts": [
    4321
  ],
  "mounts": [
    "source=csls-${devcontainerId}-home-cache,target=/home/vscode/.cache,type=volume"
  ],
  "portsAttributes": {
    "4321": {
      "label": "Documentation"
    }
  },
  "remoteEnv": {
    "CSLS_ARTIFACTS_ROOT": "/home/vscode/.cache/csls/artifacts",
    "CSLS_CACHE_ROOT": "/home/vscode/.cache",
    "CSLS_DEV_CONTAINER": "true",
    "CSLS_REPOSITORY_ROOT": "${containerWorkspaceFolder}",
    "CSLS_TOOLS_ROOT": "/home/vscode/.cache/csls/tools"
  },
  "postCreateCommand": [
    "dotnet",
    "run",
    "--file",
    "./scripts/Initialize-DevContainer.cs"
  ],
  "waitFor": "postCreateCommand",
  "remoteUser": "vscode"
}
