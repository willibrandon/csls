{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": ".NET (csls)",
  "type": "object",
  "required": [
    "request"
  ],
  "properties": {
    "request": {
      "type": "string",
      "enum": [
        "launch",
        "attach"
      ]
    },
    "program": {
      "type": "string",
      "description": "Absolute path to the managed executable or assembly."
    },
    "cwd": {
      "type": "string",
      "description": "Working directory for the launched application."
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "processId": {
      "type": "integer",
      "minimum": 1,
      "description": "Operating-system process identifier for attachment."
    },
    "symbolOptions": {
      "type": "object",
      "description": "Controls identity-validated Portable PDB discovery and caching.",
      "properties": {
        "searchPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "searchMicrosoftSymbolServer": {
          "type": "boolean",
          "default": false
        },
        "searchNuGetOrgSymbolServer": {
          "type": "boolean",
          "default": false
        },
        "cachePath": {
          "type": "string"
        },
        "moduleFilter": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "loadAllButExcluded",
                "loadOnlyIncluded"
              ],
              "default": "loadAllButExcluded"
            },
            "excludedModules": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "includedModules": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "includeSymbolsNextToModules": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "stopAtEntry": {
      "type": "boolean",
      "default": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "request": {
            "const": "launch"
          }
        }
      },
      "then": {
        "required": [
          "program"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "request": {
            "const": "attach"
          }
        }
      },
      "then": {
        "required": [
          "processId"
        ]
      }
    }
  ]
}
