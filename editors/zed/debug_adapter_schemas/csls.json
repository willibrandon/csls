{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": ".NET (csls)",
  "type": "object",
  "required": [
    "request"
  ],
  "properties": {
    "request": {
      "type": "string",
      "enum": [
        "launch",
        "attach"
      ]
    },
    "program": {
      "type": "string",
      "description": "Absolute path to the managed executable or assembly."
    },
    "cwd": {
      "type": "string",
      "description": "Working directory for the launched application."
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "envFile": {
      "type": "string",
      "minLength": 1,
      "description": "UTF-8 environment file of at most 1 MiB, absolute or relative to cwd. Explicit env entries override file assignments."
    },
    "noDebug": {
      "type": "boolean",
      "default": false,
      "description": "Launch the target without activating CoreCLR debugging."
    },
    "runtimeHost": {
      "type": "string",
      "description": "Absolute path to the compatible dotnet host used for a managed assembly."
    },
    "processId": {
      "type": "integer",
      "minimum": 1,
      "description": "Operating-system process identifier for attachment."
    },
    "dumpPath": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute path to a managed process dump for read-only thread, stack, module, and captured-variable inspection. Select either dumpPath or processId."
    },
    "runtimeIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "default": 0,
      "description": "Zero-based managed runtime index within the selected dump."
    },
    "dacPath": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute path to the matching runtime Data Access Component (DAC) for dump inspection."
    },
    "sourceFileMap": {
      "type": "object",
      "description": "Maps absolute build-time source prefixes to absolute local source prefixes.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "requireExactSource": {
      "type": "boolean",
      "default": true,
      "description": "Require local source to match its debug symbols. Set false to bind against unverified local source."
    },
    "sourceLinkOptions": {
      "type": "object",
      "description": "Controls Source Link URL patterns, including explicit private-network authorization.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "symbolOptions": {
      "type": "object",
      "description": "Controls identity-validated Portable PDB discovery and caching.",
      "properties": {
        "searchPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "searchMicrosoftSymbolServer": {
          "type": "boolean",
          "default": false
        },
        "searchNuGetOrgSymbolServer": {
          "type": "boolean",
          "default": false
        },
        "cachePath": {
          "type": "string"
        },
        "moduleFilter": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "loadAllButExcluded",
                "loadOnlyIncluded"
              ],
              "default": "loadAllButExcluded"
            },
            "excludedModules": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "includedModules": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "includeSymbolsNextToModules": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "stopAtEntry": {
      "type": "boolean",
      "default": false
    },
    "justMyCode": {
      "type": "boolean",
      "default": true,
      "description": "Restrict source stepping to symbol-bearing unoptimized user modules."
    },
    "enableStepFiltering": {
      "type": "boolean",
      "default": true,
      "description": "Skip properties, CLR operators, and debugger step-filter attributes during source stepping."
    },
    "suppressJITOptimizations": {
      "type": "boolean",
      "default": false,
      "description": "Request unoptimized JIT code for loaded managed modules during launch."
    },
    "enableHotReload": {
      "type": "boolean",
      "default": false,
      "description": "Enable CoreCLR Edit and Continue policy for compiler-driven Hot Reload updates during launch."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "request": {
            "const": "launch"
          }
        }
      },
      "then": {
        "required": [
          "program"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "request": {
            "const": "attach"
          }
        }
      },
      "then": {
        "oneOf": [
          {
            "required": ["processId"],
            "properties": {
              "dumpPath": false,
              "runtimeIndex": false,
              "dacPath": false
            }
          },
          {
            "required": ["dumpPath"],
            "properties": {
              "processId": false,
              "sourceFileMap": false,
              "sourceLinkOptions": false,
              "symbolOptions": false,
              "requireExactSource": false,
              "justMyCode": false,
              "enableStepFiltering": false
            }
          }
        ]
      }
    }
  ]
}
